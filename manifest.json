{
  "manifest_version": 3,
  "name": "AutoApply",
  "version": "0.1.0",
  "description": "Autofill job applications from your profile and resume, and draft answers with AI. Works on Greenhouse, Lever, Ashby, and Workday.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "AutoApply" },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["profile.json", "docs/*"], "matches": ["<all_urls>"] }
  ]
}
