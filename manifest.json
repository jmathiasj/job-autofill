{
  "manifest_version": 3,
  "name": "AutoApply",
  "version": "0.1.0",
  "description": "Autofill job applications from your profile and resume, and draft answers with AI. Works on Greenhouse, Lever, Ashby, Workday, iCIMS, SmartRecruiters, Workable, Jobvite, BambooHR, and Taleo.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "http://127.0.0.1:8765/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workable.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.taleo.net/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "AutoApply" },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.taleo.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["profile.json", "docs/*"], "matches": ["<all_urls>"] }
  ]
}
